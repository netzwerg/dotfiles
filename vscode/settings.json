{
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.colorTheme": "Unwind Light",
  "terminal.integrated.fontSize": 14,
  "editor.fontSize": 14,
  "editor.fontFamily": "SF Mono",
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 500,
  "git.openRepositoryInParentFolders": "always",
  "cursor.cpp.disabledLanguages": [],
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/Users/rahel.luethy@fhnw.ch/bin/fish"
    }
  },
  "terminal.integrated.defaultProfile.osx": "fish",
  "editor.formatOnType": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "gitlens.currentLine.pullRequests.enabled": false,
  "gitlens.currentLine.scrollable": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.blame.heatmap.enabled": false,
  "gitlens.blame.highlight.enabled": false,
  "gitlens.statusBar.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.enabled": false,
  "editor.renderWhitespace": "none",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.accessibilitySupport": "off",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "workbench.settings.openDefaultKeybindings": true,
  "prettier.requireConfig": true,
  "explorer.confirmDelete": false,
  "workbench.tree.indent": 20,
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "extensions.ignoreRecommendations": true,
  "typescript.experimental.updateImportsOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
  },
  "scm.alwaysShowRepositories": true,
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false
  },
  "git.confirmSync": false,
  "window.titleBarStyle": "native",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "workbench.colorCustomizations": {
      "editor.selectionBackground": "#713A9133",
      "list.hoverBackground": "#D0D0D9",
      "list.activeSelectionBackground": "#FEE9FF",
      "list.activeSelectionForeground": "#000000",
      "list.focusOutline": "#713A9133",
      "quickInputList.focusBackground": "#D0D0D9"   
  },
  "typescript.tsserver.experimental.useVsCodeWatcher": false,
  "window.openFoldersInNewWindow": "on",
  "window.newWindowDimensions": "maximized",
  "cursor.composer.textSizeScale": 1.15,
  "diffEditor.maxComputationTime": 0,
  "git.ignoreMissingGitWarning": true,
  "window.zoomLevel": 2
}
